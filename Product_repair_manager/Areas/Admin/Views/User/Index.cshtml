@using Product_repair_manager.Data
@model Product_repair_manager.Areas.Admin.Models.UserViewModel
@{
    ViewData["Title"] = "User Management";
}

<h4 class="card-title">User Management</h4>

<h5 class="mt-2"><button type="button" class="btn btn-outline-secondary"><a asp-action="Register" asp-area="Identity" asp-controller="Account">RegisterThe User</a></h5></button>

<table class="table table-striped table-bordered table-sm">
        <thead>
            <tr>
                <th>Username</th>
                <th>Roles</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users.Count() == 0)
            {
                <tr><td colspan="2" class="text-center">No Users Found</td></tr>
        } else
        {
            @foreach (ApplicationUser user in Model.Users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        @foreach (string rolename in user.rolesnames)
                        {
                            <div>@rolename</div>
                        }
                    </td>
                    <td>
                        <form method="post" asp-action="DeleteUser" asp-route-id="@user.Id">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                  </td>
                  @foreach (var role in Model.Roles)
                  {
                        if (!user.rolesnames.Contains(role.Name))
                        {
                            <td>
                                <form method="post" asp-action="AddUserToRole" asp-route-userId="@user.Id" asp-route-roleName="@role.Name">
                                    <button type="submit" class="btn btn-primary btn-sm">Add to @role.Name</button>
                                </form>
                            </td>
                        }
                        else
                        {
                            <td>
                                <form method="post" asp-action="RemoveUserFromRole" asp-route-userId="@user.Id" asp-route-roleName="@role.Name">
                                    <button type="submit" class="btn btn-warning btn-sm">Remove from @role.Name</button>
                                </form>
                            </td>
                        }
                  }
                </tr>
            }
        }
       
        </tbody>
</table>
            

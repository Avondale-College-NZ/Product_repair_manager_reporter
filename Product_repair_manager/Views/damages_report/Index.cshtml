
@model IEnumerable<Product_repair_manager.Models.damages_report>

@{
    ViewData["Title"] = "Index";
}

<h1>damge report</h1>

<p>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        @if (User.IsInRole("Admin"))
        {
    <a asp-action="Create" class="button btn btn-success pt-2">Create New</a>
        }
    }
</p>
<table class ="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                 User
            </th>
            <th>
                 Class
            </th>
            <th>
                 Serverity
            </th>
            <th>
                 Fixed
            </th>
            <th>
                 Status
            </th>
            <th>
                 Date
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @Html.DisplayFor(model => item.Id)
            </td>
            <td>
                    @Html.DisplayFor(model => item.classes.blocks)
            </td>
            <td>
                    @Html.DisplayFor(model => item.item_damages.severity)
            </td>
            <td>
                @Html.DisplayFor(model => item.fixed_report)
            </td>
            <td>
                @Html.DisplayFor(model => item.item_status)
            </td>
            <td>
                @Html.DisplayFor(model => item.Item_date)
            </td>
            <td>

                    <a asp-action="Edit" asp-route-id="@item.damages_reportId" class="button btn btn-primary pt-2">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.damages_reportId" class="button btn btn-primary pt-2">Details</a> |
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.damages_reportId" class="button btn btn-danger pt-2">Delete</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>

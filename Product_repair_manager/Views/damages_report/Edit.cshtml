@using Product_repair_manager.Data
@model Product_repair_manager.Models.damages_report

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>damages_report</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="damages_reportId" />

            <div class="form-group">
                <label asp-for="Id" class="form-label">Item that is damaged</label>
                <select asp-for="Id" class="form-control" asp-items="ViewBag.Id">
                    <option value="">-- Select user --</option>

                </select>
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClassesId" class="control-label"></label>
                <select asp-for="ClassesId" class="form-control" asp-items="ViewBag.ClassesId">
                    <option value="">-- Select classes --</option>

                </select>
                <span asp-validation-for="ClassesId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Item_damagesId" class="control-label"></label>
                <select asp-for="Item_damagesId" class="form-control" asp-items="ViewBag.Item_damagesId">
                    <option value="">-- Select damages --</option>

                </select>
                <span asp-validation-for="Item_damagesId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="fixed_report" class="control-label"></label>
                <input asp-for="fixed_report" class="form-control" />
                <span asp-validation-for="fixed_report" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="item_status" class="control-label"></label>
                <input asp-for="item_status" class="form-control" />
                <span asp-validation-for="item_status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Item_date" class="control-label"></label>
                <input asp-for="Item_date" class="form-control" />
                <span asp-validation-for="Item_date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

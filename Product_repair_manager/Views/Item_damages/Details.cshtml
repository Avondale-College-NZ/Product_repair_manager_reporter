@model Product_repair_manager.Models.Item_damages

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Item_damages</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            items that were damaged:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ItemsId)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            severity of damage:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.severity)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            what damage was it
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.damage_type)
        </dd>
    </dl>
        <dt class = "col-sm-2">
             Date in item was damaged:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.date)
        </dd>
    </dl>
      
</div>
<div>
    @if (User.IsInRole("Admin"))
    {
    <a asp-action="Edit" class="button btn btn-primary pt-2" asp-route-id="@Model?.Item_damagesId">Edit</a> <a>|</a>
    }
    @if (User.IsInRole("Staff"))
    {
        <a asp-action="Edit" class="button btn btn-primary pt-2" asp-route-id="@Model?.Item_damagesId">Edit</a> <a>|</a>
    }
    <a asp-action="Index" class="button btn btn-primary pt-2">Back to List</a>
</div>

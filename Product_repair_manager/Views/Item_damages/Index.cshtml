@model IEnumerable<Product_repair_manager.Models.Item_damages>

@{
    ViewData["Title"] = "Index";
}

<h1>Item damges</h1>

<p>
    <a asp-action="Create" class="button btn btn-success pt-2">Create New</a>
</p>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                the item
            </th>
            <th>
                severity
            </th>
            <th>
                what damage was it
            </th>
            <th>
                date of damage
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
             <td>
                    @Html.DisplayFor(model => item.Items.items_Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.severity)
            </td>
            <td>
                @Html.DisplayFor(model => item.damage_type)
            </td>
            <td>
                @Html.DisplayFor(model => item.date)
            </td>

            <td>
                    @if (User.IsInRole("Admin"))
                    {
                    <a asp-action="Edit" asp-route-id="@item.Item_damagesId" class="button btn btn-primary pt-2" [Authorize(Roles=" Admin" )]>Edit</a> <a>|</a>
                    }

                    <a asp-action="Details" asp-route-id="@item.Item_damagesId" class="button btn btn-primary pt-2">Details</a> |
                    
                    @if (User.IsInRole("Admin"))
                    {
                    <a asp-action="Delete" asp-route-id="@item.Item_damagesId" class="button btn btn-danger pt-2">Delete</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>

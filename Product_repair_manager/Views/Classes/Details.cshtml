@model Product_repair_manager.Models.Classes

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div class ="container p- my-5 border border-4">
    <h4>Classes</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            School blocks:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.blocks)
        </dd>
        <dt class="col-sm-2">
            Classroom number:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.classroom)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.ClassesId" class="button btn btn-primary pt-2">Edit</a>  <a>|</a>
    }
    @if (User.IsInRole("Staff"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.ClassesId" class="button btn btn-primary pt-2">Edit</a>  <a>|</a>
    }
    <a asp-action="Index" class="button btn btn-primary pt-2">Back to List</a>
</div>

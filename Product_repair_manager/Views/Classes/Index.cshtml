@model IEnumerable<Product_repair_manager.Models.Classes>

@{
    ViewData["Title"] = "Index";
}

<h1>Class</h1>

<p>
    <a asp-action="Create" class="button btn btn-success pt-2">Create New</a>
</p>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                school blocks
            </th>
            <th>
                classroom number
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.blocks)
            </td>
            <td>
                @Html.DisplayFor(model => item.classroom)
            </td>

            <td>
                    <a asp-action="Edit" asp-route-id="@item.ClassesId" class="button btn btn-primary pt-2">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ClassesId" class="button btn btn-primary pt-2">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ClassesId" class="button btn btn-danger pt-2">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@model IEnumerable<Product_repair_manager.Models.Catagory>
@using Product_repair_manager.Models

@{
    ViewData["Title"] = "Index";
}

<h1>Catagory</h1>

<p>
    <a asp-action="Create" class="button btn btn-success pt-2">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                
            </th>
            <th>
               
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Catagory_Name)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Catagory_Name)
            </td>

            <td>
                    <a asp-action="Edit" asp-route-id="@item.CatagoryId" class="button btn btn-primary pt-2">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.CatagoryId" class="button btn btn-primary pt-2">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.CatagoryId" class="button btn btn-danger pt-2">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
@model Product_repair_manager.Models.Items

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Items</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            catagory:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CatagoryId)
        </dd>
    </dl>
        <dt class = "col-sm-1">
            Items:
        </dt>
        <dd class = "col-sm-2">
            @Html.DisplayFor(model => model.items_Name)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" class="button btn btn-primary pt-2" asp-route-id="@Model?.ItemsId">Edit</a><a>|</a>
    }
    @if (User.IsInRole("Staff"))
    {
        <a asp-action="Edit" class="button btn btn-primary pt-2" asp-route-id="@Model?.ItemsId">Edit</a><a>|</a>
    }
    <a asp-action="Index" class="button btn btn-primary pt-2">Back to List</a>
</div>

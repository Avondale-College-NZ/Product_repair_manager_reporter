@model Product_repair_manager.Models.Items

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Items</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="CatagoryId" class="control-label"></label>
                <select asp-for="CatagoryId" class="form-control" asp-items="ViewBag.CatagoryId">
                    <option value="">-- Select "catagory" --</option>

                </select>
                <span asp-validation-for="CatagoryId" class="text-danger"></span>
            </div>


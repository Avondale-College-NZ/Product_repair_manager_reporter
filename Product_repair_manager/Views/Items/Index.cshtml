@model IEnumerable<Product_repair_manager.Models.Items>

@{
    ViewData["Title"] = "Index";
}

<h1>Items</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.items_Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Catagory.Catagory_Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.items_Name)
            </td>
                <td>
                    @Html.DisplayFor(model => item.Catagory.Catagory_Name)
                </td>
            <td>
                     @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.ItemsId" class="button btn btn-primary pt-2">Edit </a>
                    }
                    <a asp-action="Details" asp-route-id="@item.ItemsId" class="button btn btn-primary pt-2">Details </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.ItemsId" class="button btn btn-danger pt-2">Delete </a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>

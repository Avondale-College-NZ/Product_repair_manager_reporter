@model IEnumerable<Product_repair_manager.Models.Items>

@{
    ViewData["Title"] = "Index";
}

<h1>Items</h1>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="button btn btn-success pt-2">Create New</a>
    }
    @if (User.IsInRole("Staff"))
    {
        <a asp-action="Create" class="button btn btn-success pt-2">Create New</a>
    }
</p>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                 Items
            </th>
            <th>
                 Catagory
            </th>


            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.items_Name)
            </td>
                <td>
                    @Html.DisplayFor(model => item.Catagory.Catagory_Name)
                </td>
            <td>
               @if (User.IsInRole("Admin"))
               {
                        <a asp-action="Edit" asp-route-id="@item.ItemsId" class="button btn btn-primary pt-2">Edit</a> <a>|</a>
               }

                    <a asp-action="Details" asp-route-id="@item.ItemsId" class="button btn btn-primary pt-2">Details</a> |

               @if (User.IsInRole("Admin"))
               {
                        <a asp-action="Delete" asp-route-id="@item.ItemsId" class="button btn btn-danger pt-2">Delete</a> <a>|</a>
               }
            </td>
        </tr>
}
    </tbody>
</table>
